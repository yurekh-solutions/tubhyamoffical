# SMS Service Configuration (MSG91 - Free for India)
# Get free API key from: https://msg91.com
VITE_SMS_API_KEY=

# Twilio Configuration for SMS OTP (Alternative - Paid)
# Replace these with your actual Twilio credentials from https://console.twilio.com
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=

# Firebase Configuration (optional - currently not used)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
