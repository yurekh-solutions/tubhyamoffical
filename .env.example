# Frontend env — only PUBLIC keys here. Backend URL is proxied via vercel.json
# VITE_API_URL is intentionally NOT set — the app uses relative '/api' (proxied by Vercel)

# Razorpay publishable key (safe to be public — designed for client-side checkout)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
