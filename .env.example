# Twilio Configuration for SMS OTP
VITE_TWILIO_ACCOUNT_SID=your_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_auth_token_here
VITE_TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Instagram API Configuration
# Get your access token from: https://developers.facebook.com/
# Your User ID is a number (e.g., 17841405793187218), not a URL
# Find it by visiting: https://graph.instagram.com/me?fields=id,username&access_token=YOUR_TOKEN
VITE_INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
VITE_INSTAGRAM_USER_ID=your_numeric_instagram_user_id_here

# Firebase Configuration (optional - currently not used)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
